        <roads>
            <functions>
                <!-- road width  -->
                <object name="function.width_in_pixels_motorways" type="CLinearSeqmentsFunction">
                    <definition value = "3.5 ~ -0.7; 5 ~ 1.5; 7 ~ 2.5; 12 ~ 3; 14 ~ 7; 18 ~ 20; 20 ~ 32"/>
                </object>
                <object name="function.width_in_pixels_major" type="CLinearSeqmentsFunction">
                    <definition value = "3.5 ~ -1.7; 7 ~ -1.5; 9 ~ 2; 12 ~ 2; 14 ~ 6; 18 ~ 18; 20 ~ 28"/>
                </object>
                <object name="function.width_in_pixels_main" type="CLinearSeqmentsFunction">
                    <definition value = "3.5 ~ -1.7; 4 ~ -1.7; 5 ~ -1.0; 12 ~ 2; 14 ~ 6; 18 ~ 18; 20 ~ 28"/>
                </object>
                <object name="function.width_in_pixels_secondary_roads" type="CLinearSeqmentsFunction">
                    <definition value = "6.5 ~ -1; 7 ~ -1.5; 9 ~ 2; 14 ~ 5; 18 ~ 18; 20 ~ 26"/>
                </object>
                <object name="function.width_in_pixels_connecting_roads" type="CLinearSeqmentsFunction">
                    <definition value = "7 ~ -1.5; 10.5 ~ -1; 10.6 ~ 2; 14.1 ~ 5; 18 ~ 18; 20 ~ 26"/>
                </object>
                <object name="function.width_in_pixels_high_importance" type="CLinearSeqmentsFunction">
                    <definition value = "12 ~ 2; 14 ~ 3; 18 ~ 18; 20 ~ 26"/>
                </object>
                <object name="function.width_in_pixels_local_roads" type="CLinearSeqmentsFunction">
                    <definition value = "12 ~ 0.5; 14 ~ 2; 18 ~ 18; 20 ~ 26"/>
                </object>
